# Our billing-enabled project is set up for Vertex AI, not the AI-Studio-style
# Generative Language API — per professor's instructions. The pipeline code
# already passes vertexai=True explicitly (see agents/llm/llm.py), but this
# is also set here so any standalone script using google.genai.Client()
# directly (like the professor's test snippet) picks up the right backend too.
GOOGLE_GENAI_USE_VERTEXAI=True

ZAI_API_KEY=your_zai_api_key_here