# ================================================================================
# api keys
# ================================================================================
OPENAI_API_KEY=your_openai_api_key_here

# Vertex AI / Google Cloud key used by the pipeline and baseline.
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
GOOGLE_AI_STUDIO_API_KEY=your_ai_studio_api_key_here

# Keep this true when routing Gemini calls through Vertex AI. The pipeline also
# passes ``vertexai=True`` explicitly; this variable covers standalone SDK use.
GOOGLE_GENAI_USE_VERTEXAI=true

ZAI_API_KEY=your_zai_api_key_here
