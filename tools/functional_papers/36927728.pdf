          <figure class="captioned-asset">
          
              <a href="https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig1-v2.tif/full/1500,/0/default.jpg" class="captioned-asset__link" target="_blank" rel="noopener noreferrer">
              <picture class="captioned-asset__picture">
                  <source srcset="https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig1-v2.tif/full/1234,/0/default.webp 2x, https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig1-v2.tif/full/617,/0/default.webp 1x"
                      type="image/webp"
                      >
                  <source srcset="https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig1-v2.tif/full/1234,/0/default.jpg 2x, https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig1-v2.tif/full/617,/0/default.jpg 1x"
                      type="image/jpeg"
                      >
                  <img src="https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig1-v2.tif/full/617,/0/default.jpg"
                       
                       alt=""
