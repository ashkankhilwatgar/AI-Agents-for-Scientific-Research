                    <a class="additional-asset__link additional-asset__link--download" href="https://elifesciences.org/download/aHR0cHM6Ly9jZG4uZWxpZmVzY2llbmNlcy5vcmcvYXJ0aWNsZXMvODIzNDUvZWxpZmUtODIzNDUtZmlnMi1kYXRhMS12Mi54bHN4/elife-82345-fig2-data1-v2.xlsx?_hash=OmSTooee56Xcbctn4ggsWA3nj82vkDR7AxtI2fPpocY%3D" download="elife-82345-fig2-data1-v2.xlsx">Download elife-82345-fig2-data1-v2.xlsx</a>
                  </div>
