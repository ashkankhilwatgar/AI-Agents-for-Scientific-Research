          </div>
    
    
            <div class="asset-viewer-inline__figure_access">
              <a href="https://elifesciences.org/download/aHR0cHM6Ly9paWlmLmVsaWZlc2NpZW5jZXMub3JnL2xheDo4MjM0NSUyRmVsaWZlLTgyMzQ1LWZpZzMtdjIudGlmL2Z1bGwvZnVsbC8wL2RlZmF1bHQuanBn/elife-82345-fig3-v2.jpg?_hash=c6B7Yt7HrWwC4k%2FeTazTJtZHj9x4r5PNl4e0bdLJ67Y%3D" class="asset-viewer-inline__download_all_link" download="Download"><span class="visuallyhidden">Download asset</span></a>
