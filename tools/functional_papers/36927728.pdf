            </div>
    
      </div>
    
          <figure class="captioned-asset">
          
              <a href="https://iiif.elifesciences.org/lax:82345%2Felife-82345-fig2-v2.tif/full/1500,/0/default.jpg" class="captioned-asset__link" target="_blank" rel="noopener noreferrer">
